{
  "compilerOptions": {
    "noEmit": true,
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "typeRoots": ["./.direnv/types"],
    "types": ["node"]
  },
  "include": ["plugins/moiras/scripts/*.ts"]
}
